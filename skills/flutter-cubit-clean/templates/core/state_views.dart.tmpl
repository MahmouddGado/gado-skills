import 'package:flutter/material.dart';

import 'package:__core__/core/error/failure.dart';
import 'package:__core__/l10n/failure_l10n.dart';
import 'package:__core__/l10n/l10n_x.dart';

final class AppLoading extends StatelessWidget {
  const AppLoading({super.key});

  @override
  Widget build(BuildContext context) => const Center(child: CircularProgressIndicator());
}

final class AppEmpty extends StatelessWidget {
  const AppEmpty({required this.message, super.key});

  final String message;

  @override
  Widget build(BuildContext context) => Center(
    child: Padding(
      padding: const EdgeInsetsDirectional.all(24),
      child: Text(message, textAlign: TextAlign.center),
    ),
  );
}

final class AppError extends StatelessWidget {
  const AppError({required this.failure, required this.onRetry, super.key});

  final Failure failure;
  final VoidCallback onRetry;

  @override
  Widget build(BuildContext context) => Center(
    child: Padding(
      padding: const EdgeInsetsDirectional.all(24),
      child: Column(
        mainAxisSize: MainAxisSize.min,
        spacing: 16,
        children: [
          Text(failure.localized(context.l10n), textAlign: TextAlign.center),
          FilledButton(onPressed: onRetry, child: Text(context.l10n.commonRetry)),
        ],
      ),
    ),
  );
}
